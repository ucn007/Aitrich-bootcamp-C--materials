@page "/home"

@using Destination.Model
@using System.ComponentModel.DataAnnotations
@inject Destination.Interface.ITourService TourService
@inject NavigationManager Navigation

<h3 class="mb-3">Add Tour</h3>
<p class="text-muted">Create a memorable travel experience</p>

<div class="card shadow p-4">

    <EditForm Model="tour" OnValidSubmit="CreateTour">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Toggle -->
        <div class="d-flex justify-content-between align-items-center mb-4 border rounded p-3">
            <div>
                <strong>Customized Tour</strong>
                <div class="text-muted small">
                    Create a personalized tour for a specific customer
                </div>
            </div>

            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" @bind="IsCustomized" />
            </div>
        </div>

        <!-- Title -->
        <div class="mb-3">
            <label class="form-label">Tour Title *</label>
            <input class="form-control" @bind="tour.Title" />
            <ValidationMessage For="@(() => tour.Title)" />
        </div>

        <!-- Description -->
        <div class="mb-3">
            <label class="form-label">Description *</label>
            <textarea class="form-control" @bind="tour.Description"></textarea>
            <ValidationMessage For="@(() => tour.Description)" />
        </div>

        <!-- Destination + Nights -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label>Destination *</label>
                <select class="form-select" @bind="tour.Destination">
                    <option value="">Select destination</option>
                    <option>Kerala</option>
                    <option>Dubai</option>
                    <option>Bali</option>
                    <option>Singapore</option>
                </select>
                <ValidationMessage For="@(() => tour.Destination)" />
            </div>

            <div class="col-md-6">
                <label>Number of Nights *</label>
                <input type="number" class="form-control" @bind="tour.Nights" />
                <ValidationMessage For="@(() => tour.Nights)" />
            </div>
        </div>

        <!-- Price + Departure -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label>Price *</label>
                <input type="number" class="form-control" @bind="tour.Price" />
                <ValidationMessage For="@(() => tour.Price)" />
            </div>

            <div class="col-md-6">
                <label>Departure Date *</label>
                <input type="date" class="form-control" @bind="tour.DepartureDate" />
                <ValidationMessage For="@(() => tour.DepartureDate)" />
            </div>
        </div>

        <!-- Arrival -->
        <div class="mb-4">
            <label>Arrival Date</label>
            <input type="date" class="form-control"
                   @bind="tour.ArrivalDate"
                   min="@tour.DepartureDate?.ToString("yyyy-MM-dd")" />
        </div>

        <!-- Buttons -->
        <div class="d-flex justify-content-end">
            <button type="button" class="btn btn-secondary me-2" @onclick="Cancel">Cancel</button>
            <button type="submit" class="btn btn-primary">Create Tour</button>
        </div>

    </EditForm>

</div>

@code {
    private bool IsCustomized { get; set; }

    private Tour tour = new Tour
    {
        Nights = 1
    };

    private async Task CreateTour()
    {
        await TourService.CreateTourAsync(tour);

        Console.WriteLine("Saved to DB!");

        Navigation.NavigateTo("/TourView");

        // Reset form
        tour = new Tour { Nights = 1 };
        IsCustomized = false;
    }

    private void Cancel()
    {
        tour = new Tour { Nights = 1 };
        IsCustomized = false;
    }
}