@page "/create"
@inject IDestinationService DestinationService
@inject NavigationManager Navigation
@inject IWebHostEnvironment Env
@using TourManagement.Dto
@using TourManagement.Interface
@using Microsoft.AspNetCore.Components.Forms

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 shadow-lg">

            <!-- Modal Header -->
            <div class="modal-header border-0">
                <div>
                    <h4 class="fw-bold">
                        <i class="bi bi-plus-circle"></i> Add Destination
                    </h4>
                    <small class="text-muted">Add a new travel destination</small>
                </div>

                <button type="button" class="btn-close"
                        @onclick="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">

                <EditForm Model="destination" OnValidSubmit="SaveDestination">
                    <DataAnnotationsValidator />

                    <!-- Destination Name -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Destination Name *
                        </label>
                        <InputText class="form-control form-control-lg"
                                   placeholder="e.g., Maldives, Bali, Dubai"
                                   @bind-Value="destination.Name" />
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Description *
                        </label>
                        <InputTextArea class="form-control"
                                       rows="4"
                                       placeholder="Describe the destination..."
                                       @bind-Value="destination.Description" />
                    </div>

                    <!-- Image Upload -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Image Upload *
                        </label>

                        <InputFile OnChange="HandleFileUpload"
                                   class="form-control" />

                        <small class="text-muted">
                            Max 5MB
                        </small>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-end mt-4">

                        <button type="button"
                                class="btn btn-light me-2"
                                @onclick="Close">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            <i class="bi bi-plus-circle"></i>
                            Add Destination
                        </button>

                    </div>

                </EditForm>

            </div>
        </div>
    </div>
</div>

@code {

    private DestinationDto destination = new();
    private IBrowserFile uploadedFile;

    private void HandleFileUpload(InputFileChangeEventArgs e)
    {
        uploadedFile = e.File;
    }

    private async Task<string> SaveImageAsync()
    {
        if (uploadedFile == null)
            return null;

        var folderPath = Path.Combine(Env.WebRootPath, "images");

        if (!Directory.Exists(folderPath))
            Directory.CreateDirectory(folderPath);

        var uniqueFileName = Guid.NewGuid().ToString() +
                             Path.GetExtension(uploadedFile.Name);

        var filePath = Path.Combine(folderPath, uniqueFileName);

        using var stream = new FileStream(filePath, FileMode.Create);
        await uploadedFile.OpenReadStream(5 * 1024 * 1024)
                          .CopyToAsync(stream);

        return "/images/" + uniqueFileName;
    }

    private async Task SaveDestination()
    {
        destination.ImageUrl = await SaveImageAsync();
        await DestinationService.AddAsync(destination);
        Navigation.NavigateTo("/");
    }

    private void Close()
    {
        Navigation.NavigateTo("/");
    }
}
