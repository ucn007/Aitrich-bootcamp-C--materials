@using mvc_e_com.Model
@{
    ViewData["Title"] = "Home Page";

    var categories = ViewBag.Categories as List<Category>
                     ?? new List<Category>();

    var products = ViewBag.Products as List<Product>
                   ?? new List<Product>();
}

<div class="py-5">

    <!-- Hero Section -->
    <div class="p-5 mb-5 bg-light rounded-4 text-center">
        <h1 class="display-5 fw-bold">Welcome to Our Store</h1>
        <p class="lead text-muted">
            Discover quality products at amazing prices.
        </p>
        <a href="#products" class="btn btn-primary btn-lg">
            Shop Now
        </a>
    </div>

    <!-- Categories -->
    <section class=" mb-5">
        <div class="container">
            <h2 class="mb-4">Shop by Category</h2>

            <div class="row g-4">
                @foreach (var category in categories)
                {
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 text-center h-100">
                            <div class="card-body py-4">
                                <div class="display-5 mb-3">
                                    <img src=" @category.ImageUrl"
                                         class="card-img-top"
                                         alt="@category.Name"
                                         style="height: 200px; object-fit: cover;"/>
                                  
                                </div>

                                <h5 class="card-title">
                                    @category.Name
                                </h5>

                                <a href="#" class="btn btn-outline-primary btn-sm mt-2">
                                    Explore
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
     
    </section>

    <!-- Products -->
    <section id="products">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Featured Products</h2>
                <a href="#" class="btn btn-outline-secondary">
                    View All
                </a>
            </div>

            <div class="row g-4">
                @foreach (var product in products)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                            <img src="@product.ImageUrl"
                                 class="card-img-top"
                                 alt="@product.Name"
                                 style="height: 200px; object-fit: cover;"/>

                            <div class="card-body d-flex flex-column">
                                <small class="text-muted mb-2">
                                    @product.Category
                                </small>

                                <h5 class="card-title">
                                    @product.Name
                                </h5>

                                <h5 class="text-primary mt-auto mb-3">
                                    ₹@product.Price.ToString("N0")
                                </h5>

                                <button class="btn btn-primary w-100">
                                    Add to Cart
                                </button>
                            </div>

                        </div>
                    </div>
                }
            </div>
        </div>
    
    </section>

</div>