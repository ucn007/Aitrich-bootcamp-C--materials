
@page "/Register"

@layout AuthLayout

@using BlazorApp5.Components.Layout
@using BlazorApp5.DTOs
@using BlazorApp5.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IUserService UserService
@inject NavigationManager Navigation

@attribute [AllowAnonymous]

<PageTitle>Register</PageTitle>

<div class="register-page">

    <div class="register-card">

        <div class="register-header">
            <h2>Create Account</h2>
            <p>Register to get started</p>
        </div>

        <EditForm Model="@registerDto" FormName="registerForm" OnValidSubmit="@HandleRegister">
            <DataAnnotationsValidator />

            <ValidationSummary />
           

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">
                    @successMessage
                </div>
            }

            <div class="form-group">
                <label for="name">Name</label>

                <InputText
                    id="name"
                    class="form-control"
                    @bind-Value="registerDto.Name"
                    placeholder="Enter your name" />

                <ValidationMessage For="@(() => registerDto.Name)" />
            </div>

            <div class="form-group">
                <label for="email">Email</label>

                <InputText
                    id="email"
                    type="email"
                    class="form-control"
                    @bind-Value="registerDto.Email"
                    placeholder="Enter your email" />

                <ValidationMessage For="@(() => registerDto.Email)" />
            </div>

            <div class="form-group">
                <label for="phone">Phone Number</label>

                <InputText
                    id="phone"
                    type="tel"
                    class="form-control"
                    @bind-Value="registerDto.PhoneNumber"
                    placeholder="Enter your phone number" />

                <ValidationMessage For="@(() => registerDto.PhoneNumber)" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>

                <InputText
                    id="password"
                    type="password"
                    class="form-control"
                    @bind-Value="registerDto.Password"
                    placeholder="Enter your password" />

                <ValidationMessage For="@(() => registerDto.Password)" />
            </div>

            <button
                type="submit"
                class="btn btn-primary register-button"
                disabled="@isLoading">

                @if (isLoading)
                {
                    <span>Creating account...</span>
                }
                else
                {
                    <span>Register</span>
                }

            </button>

        </EditForm>

        <div class="login-link">
            <span>Already have an account?</span>
            <a href="/Login">Login</a>
        </div>

    </div>

</div>

@code {

    private RegisterDto registerDto = new();

    private string? errorMessage;
    private string? successMessage;

    private bool isLoading;

    private async Task HandleRegister()
    {
        errorMessage = null;
        successMessage = null;
        isLoading = true;

        try
        {
            var response = await UserService.RegisterAsync(registerDto);

            if (response == null)
            {
                errorMessage = "An account with this email already exists.";
                return;
            }

            successMessage = "Registration successful! Redirecting to login...";

            await Task.Delay(1000);

            Navigation.NavigateTo("/Login");
        }
        catch (Exception)
        {
            errorMessage = "Something went wrong. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
