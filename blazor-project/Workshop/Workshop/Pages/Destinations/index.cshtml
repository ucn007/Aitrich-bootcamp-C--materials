@page
@model Workshop.Pages.Destinations.IndexModel

@{
    ViewData["Title"] = "Destinations";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Destinations</h1>
            <p class="text-muted mb-0">
                Explore our available destinations
            </p>
        </div>

        <a asp-page="/Destinations/Create" class="btn btn-primary">
            + Add Destination
        </a>
    </div>

    @if (Model.Destinations.Any())
    {
        <div class="row g-4">

            @foreach (var destination in Model.Destinations)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card destination-card h-100">

                        @if (!string.IsNullOrEmpty(destination.ImagePath))
                        {
                            <img src="@destination.ImagePath"
                                 class="card-img-top destination-image"
                                 alt="@destination.Name" />
                        }
                        else
                        {
                            <div class="destination-image-placeholder">
                                No Image
                            </div>
                        }

                        <div class="card-body">

                            <h5 class="card-title fw-bold">
                                @destination.Name
                            </h5>

                            <p class="text-muted mb-3">
                                📍 @destination.City
                            </p>

                            <div class="d-flex gap-2">

                                <a asp-page="/Destinations/Update"
                                   asp-route-id="@destination.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit
                                </a>

                                <a asp-page="/Destinations/Delete"
                                   asp-route-id="@destination.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    Delete
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <h4>No destinations found</h4>

            <p class="text-muted">
                Add your first destination to get started.
            </p>

            <a asp-page="/Destinations/Create"
               class="btn btn-primary">
                Add Destination
            </a>

        </div>
    }

</div>