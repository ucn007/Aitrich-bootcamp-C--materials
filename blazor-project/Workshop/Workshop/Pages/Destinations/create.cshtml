@page
@model Workshop.Pages.Destinations.CreateModel

@{
    ViewData["Title"] = "Add Destination";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h2 class="mb-1">Add Destination</h2>

                    <p class="text-muted mb-4">
                        Add a new destination
                    </p>

                    <form method="post" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Name -->
                        <div class="mb-3">
                            <label asp-for="Destination.Name"
                                   class="form-label">
                                Destination Name
                            </label>

                            <input asp-for="Destination.Name"
                                   class="form-control"
                                   placeholder="Enter destination name" />

                            <span asp-validation-for="Destination.Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- City -->
                        <div class="mb-3">
                            <label asp-for="Destination.City"
                                   class="form-label">
                                City
                            </label>

                            <input asp-for="Destination.City"
                                   class="form-control"
                                   placeholder="Enter city" />

                            <span asp-validation-for="Destination.City"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Image -->
                        <div class="mb-4">
                            <label asp-for="Destination.ImageFile"
                                   class="form-label">
                                Destination Image
                            </label>

                            <input asp-for="Destination.ImageFile"
                                   type="file"
                                   class="form-control"
                                   accept="image/*" />

                            <span asp-validation-for="Destination.ImageFile"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Add Destination
                            </button>

                            <a asp-page="/Destinations/Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}