```
<title>Login - Exercise</title>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<style>
    * {
        box-sizing: border-box;
    }

    body {
        min-height: 100vh;
        margin: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #f5f7fb;
        font-family: Arial, sans-serif;
    }

    .login-wrapper {
        width: 100%;
        max-width: 420px;
        padding: 20px;
    }

    .login-card {
        padding: 40px 35px;

        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;

        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    }

    .logo {
        width: 52px;
        height: 52px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin: 0 auto 20px;

        border-radius: 12px;

        background: #0d6efd;
        color: white;

        font-size: 24px;
        font-weight: 700;
    }

    .login-title {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .login-subtitle {
        text-align: center;
        color: #6c757d;
        margin-bottom: 30px;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 7px;
    }

    .form-control {
        min-height: 46px;
        border-radius: 8px;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12);
    }

    .login-btn {
        min-height: 48px;
        border-radius: 8px;
        font-weight: 600;
    }

    .register-text {
        text-align: center;
        margin-top: 25px;
        margin-bottom: 0;
        color: #6c757d;
    }

    .register-text a {
        color: #0d6efd;
        font-weight: 600;
        text-decoration: none;
    }

    .register-text a:hover {
        text-decoration: underline;
    }

    .forgot-password {
        font-size: 14px;
        color: #0d6efd;
        text-decoration: none;
    }

    .forgot-password:hover {
        text-decoration: underline;
    }
</style>


</head>

<body>

<div class="login-wrapper">


<div class="login-card">

    <div class="logo">
        E
    </div>

    <h1 class="login-title">
        Welcome Back
    </h1>

    <p class="login-subtitle">
        Sign in to continue to your account
    </p>

    <form method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <!-- Email -->
        <div class="mb-3">

            <label asp-for="Email"
                   class="form-label">
                Email Address
            </label>

            <input asp-for="Email"
                   class="form-control"
                   type="email"
                   placeholder="Enter your email" />

            <span asp-validation-for="Email"
                  class="text-danger">
            </span>

        </div>

        <!-- Password -->
        <div class="mb-3">

            <div class="d-flex justify-content-between">

                <label asp-for="Password"
                       class="form-label">
                    Password
                </label>

                <a href="#"
                   class="forgot-password">
                    Forgot password?
                </a>

            </div>

            <input asp-for="Password"
                   class="form-control"
                   type="password"
                   placeholder="Enter your password" />

            <span asp-validation-for="Password"
                  class="text-danger">
            </span>

        </div>

        <!-- Remember Me -->b

        <!-- Login -->
        <button type="submit"
                class="btn btn-primary w-100 login-btn">
            Login
        </button>

    </form>

    <p class="register-text">
        Don't have an account?
        <a asp-page="/Register">
            Create an account
        </a>
    </p>

</div>


</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
