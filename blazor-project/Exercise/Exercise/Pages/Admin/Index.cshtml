```
<title>Admin Dashboard - Exercise</title>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f5f7fb;
        font-family: Arial, sans-serif;
        color: #212529;
    }

    .admin-layout {
        display: flex;
        min-height: 100vh;
    }

    /* Sidebar */
    .sidebar {
        width: 260px;
        min-height: 100vh;
        padding: 25px 15px;
        background: #212529;
        color: #fff;
    }

    .sidebar-brand {
        display: block;
        padding: 10px 15px 30px;
        color: #fff;
        font-size: 22px;
        font-weight: 700;
        text-decoration: none;
    }

    .sidebar-title {
        padding: 0 15px;
        margin-bottom: 10px;
        color: #adb5bd;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .sidebar-menu {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .sidebar-menu li {
        margin-bottom: 6px;
    }

    .sidebar-menu a {
        display: block;
        padding: 12px 15px;
        border-radius: 8px;
        color: #ced4da;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .sidebar-menu a:hover,
    .sidebar-menu a.active {
        background: #0d6efd;
        color: #fff;
    }

    /* Main */
    .admin-main {
        flex: 1;
        min-width: 0;
    }

    .admin-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 35px;
        background: #fff;
        border-bottom: 1px solid #e9ecef;
    }

    .admin-header h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 700;
    }

    .admin-content {
        padding: 35px;
    }

    /* Welcome */
    .welcome-section {
        margin-bottom: 30px;
    }

    .welcome-section h2 {
        margin-bottom: 8px;
        font-size: 28px;
        font-weight: 700;
    }

    .welcome-section p {
        margin: 0;
        color: #6c757d;
    }

    /* Action Cards */
    .action-card {
        height: 100%;
        padding: 25px;
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .action-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }

    .action-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        border-radius: 12px;
        background: #e7f1ff;
        font-size: 26px;
    }

    .action-card h3 {
        font-size: 18px;
        font-weight: 700;
    }

    .action-card p {
        min-height: 48px;
        color: #6c757d;
        line-height: 1.6;
    }

    /* Statistics */
    .stats-section {
        margin-top: 40px;
    }

    .section-title {
        margin-bottom: 20px;
        font-size: 22px;
        font-weight: 700;
    }

    .stat-card {
        padding: 22px;
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    .stat-label {
        margin-bottom: 8px;
        color: #6c757d;
        font-size: 14px;
    }

    .stat-number {
        margin: 0;
        font-size: 32px;
        font-weight: 700;
    }

    /* Recent Section */
    .recent-section {
        margin-top: 40px;
    }

    .recent-card {
        padding: 25px;
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
    }

    .recent-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 0;
        border-bottom: 1px solid #f1f1f1;
    }

    .recent-item:last-child {
        border-bottom: 0;
    }

    .recent-item h5 {
        margin: 0 0 5px;
        font-size: 16px;
        font-weight: 600;
    }

    .recent-item p {
        margin: 0;
        color: #6c757d;
        font-size: 14px;
    }

    
</style>
```

</head>

<body>

<div class="admin-layout">

```
<!-- SIDEBAR -->
<aside class="sidebar">

    <a asp-page="/Admin/Index"
       class="sidebar-brand">
        Exercise Admin
    </a>

    <div class="sidebar-title">
        Management
    </div>

    <ul class="sidebar-menu">

        <li>
            <a asp-page="/Admin/Index"
               class="active">
                Dashboard
            </a>
        </li>

        <li>
            <a asp-page="Admin/Destinations/Create">
                Add Destination
            </a>
        </li>

        <li>
            <a asp-page="Admin/Destinations/Index">
                Added Destinations
            </a>
        </li>

        <li>
            <a asp-page="Admin/Tours/Create">
                Add Tour Package
            </a>
        </li>

        <li>
            <a asp-page="Admin/Tours/Index">
                Added Tour Packages
            </a>
        </li>

    </ul>

</aside>


<!-- MAIN CONTENT -->
<main class="admin-main">

    <!-- Header -->
    <header class="admin-header">

        <h1>
            Dashboard
        </h1>

        <div>
            <a asp-page="/Index"
               class="btn btn-outline-secondary btn-sm">
                View Website
            </a>

            <a asp-page="/Login"
               class="btn btn-primary btn-sm ms-2">
                Logout
            </a>
        </div>

    </header>


    <!-- Content -->
    <div class="admin-content">

        <!-- Welcome -->
        <div class="welcome-section">

            <h2>
                Welcome, Admin 👋
            </h2>

            <p>
                Manage your destinations and tour packages from one place.
            </p>

        </div>


        <!-- QUICK ACTIONS -->
        <div class="row g-4">

            <!-- Add Destination -->
            <div class="col-md-6 col-xl-3">

                <div class="action-card">

                    <div class="action-icon">
                        📍
                    </div>

                    <h3>
                        Add Destination
                    </h3>

                    <p>
                        Create and add a new travel destination.
                    </p>

                    <a asp-page="/Destinations/Create"
                       class="btn btn-primary w-100">
                        Add Destination
                    </a>

                </div>

            </div>


            <!-- View Destinations -->
            <div class="col-md-6 col-xl-3">

                <div class="action-card">

                    <div class="action-icon">
                        🌍
                    </div>

                    <h3>
                        Added Destinations
                    </h3>

                    <p>
                        View and manage all available destinations.
                    </p>

                    <a asp-page="/Destinations/Index"
                       class="btn btn-outline-primary w-100">
                        View Destinations
                    </a>

                </div>

            </div>


            <!-- Add Tour -->
            <div class="col-md-6 col-xl-3">

                <div class="action-card">

                    <div class="action-icon">
                        ✈️
                    </div>

                    <h3>
                        Add Tour Package
                    </h3>

                    <p>
                        Create a new tour package for customers.
                    </p>

                    <a asp-page="/Tours/Create"
                       class="btn btn-primary w-100">
                        Add Tour
                    </a>

                </div>

            </div>


            <!-- View Tours -->
            <div class="col-md-6 col-xl-3">

                <div class="action-card">

                    <div class="action-icon">
                        🧳
                    </div>

                    <h3>
                        Added Tour Packages
                    </h3>

                    <p>
                        View and manage all your tour packages.
                    </p>

                    <a asp-page="/Tours/Index"
                       class="btn btn-outline-primary w-100">
                        View Tours
                    </a>

                </div>

            </div>

        </div>


        <!-- STATISTICS -->
        <section class="stats-section">

            <h3 class="section-title">
                Overview
            </h3>

            <div class="row g-4">

                <div class="col-md-6">

                    <div class="stat-card">

                        <p class="stat-label">
                            Total Destinations
                        </p>

                        <h2 class="stat-number">
                            0
                        </h2>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="stat-card">

                        <p class="stat-label">
                            Total Tour Packages
                        </p>

                        <h2 class="stat-number">
                            0
                        </h2>

                    </div>

                </div>

            </div>

        </section>


        <!-- RECENT ITEMS -->
        <section class="recent-section">

            <div class="row g-4">

                <!-- Recent Destinations -->
                <div class="col-lg-6">

                    <div class="recent-card">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <h3 class="section-title mb-0">
                                Recent Destinations
                            </h3>

                            <a asp-page="/Destinations/Index"
                               class="text-decoration-none">
                                View All
                            </a>

                        </div>

                        <div class="text-center py-4 text-muted">
                            No destinations added yet.
                        </div>

                    </div>

                </div>


                <!-- Recent Tours -->
                <div class="col-lg-6">

                    <div class="recent-card">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <h3 class="section-title mb-0">
                                Recent Tour Packages
                            </h3>

                            <a asp-page="/Tours/Index"
                               class="text-decoration-none">
                                View All
                            </a>

                        </div>

                        <div class="text-center py-4 text-muted">
                            No tour packages added yet.
                        </div>

                    </div>

                </div>

            </div>

        </section>

    </div>

</main>
```

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
