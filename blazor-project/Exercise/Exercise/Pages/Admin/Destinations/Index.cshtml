@page
@model Exercise.Pages.Admin.Destinations.IndexModel

@{
Layout = null;
ViewData["Title"] = "Manage Destinations";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

```
<title>Manage Destinations - Exercise</title>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<style>
    body {
        margin: 0;
        background: #f6f8fc;
        font-family: Arial, sans-serif;
        color: #212529;
    }

    .admin-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .page-header h1 {
        margin: 0 0 6px;
        font-size: 32px;
        font-weight: 700;
    }

    .page-header p {
        margin: 0;
        color: #6c757d;
    }

    .destination-card {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
    }

    .destination-image {
        width: 100%;
        height: 180px;
        object-fit: cover;
    }

    .image-placeholder {
        height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef2f7;
        color: #6c757d;
        font-size: 40px;
    }

    .destination-body {
        padding: 20px;
    }

    .destination-body h3 {
        margin-bottom: 8px;
        font-size: 20px;
        font-weight: 700;
    }

    .destination-city {
        color: #6c757d;
        margin-bottom: 18px;
    }

    .destination-actions {
        display: flex;
        gap: 8px;
    }

    .empty-state {
        padding: 70px 20px;
        text-align: center;
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 14px;
    }

    .empty-icon {
        font-size: 50px;
        margin-bottom: 15px;
    }

    .empty-state h3 {
        font-size: 22px;
        font-weight: 700;
    }

    .empty-state p {
        color: #6c757d;
    }

    @@media (max-width: 576px) {
        .admin-container {
            padding: 25px 15px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-header h1 {
            font-size: 27px;
        }

        .page-header .btn {
            width: 100%;
        }
    }
</style>
```

</head>

<body>

<div class="admin-container">

```
<!-- Header -->
<div class="page-header">

    <div>
        <h1>Destinations</h1>

        <p>
            Add and manage your travel destinations.
        </p>
    </div>

    <a asp-page="/Admin/Destinations/Create"
       class="btn btn-primary">
        + Add Destination
    </a>

</div>


<!-- Destinations -->
@if (Model.Destinations != null && Model.Destinations.Any())
{
    <div class="row g-4">

        @foreach (var destination in Model.Destinations)
        {
            <div class="col-12 col-md-6 col-lg-4">

                <div class="destination-card">

                    @if (!string.IsNullOrEmpty(destination.ImagePath))
                    {
                        <img src="@destination.ImagePath"
                             alt="@destination.Name"
                             class="destination-image" />
                    }
                    else
                    {
                        <div class="image-placeholder">
                            📍
                        </div>
                    }

                    <div class="destination-body">

                        <h3>
                            @destination.Name
                        </h3>

                        <div class="destination-city">
                            📍 @destination.City
                        </div>

                        <div class="destination-actions">

                            <a asp-page="/Admin/Destinations/Update"
                               asp-route-id="@destination.Id"
                               class="btn btn-outline-primary btn-sm">
                                Edit
                            </a>

                            <a asp-page="/Admin/Destinations/Delete"
                               asp-route-id="@destination.Id"
                               class="btn btn-outline-danger btn-sm">
                                Delete
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <!-- Empty State -->
    <div class="empty-state">

        <div class="empty-icon">
            📍
        </div>

        <h3>No Destinations Added</h3>

        <p>
            You haven't added any destinations yet.
        </p>

        <a asp-page="/Admin/Destinations/Create"
           class="btn btn-primary">
            + Add Your First Destination
        </a>

    </div>
}
```

</div>

</body>
</html>
