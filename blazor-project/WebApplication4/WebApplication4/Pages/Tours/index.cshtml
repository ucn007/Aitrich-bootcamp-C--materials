@page
@model WebApplication4.Pages.Tours.IndexModel

@{
    ViewData["Title"] = "Tours";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold">Tours</h1>
            <p class="text-muted">
                Explore and manage your available tours.
            </p>
        </div>

        
        <!-- Search -->
        <form method="get" class="d-flex">
            <input type="text"
                   name="SearchItem"
                   value="@Model.SearchItem"
                   class="form-control"
                   placeholder="Search tours..."
                   style="width: 250px;" />

            <button type="submit" class="btn btn-outline-primary ms-2">
                Search
            </button>
        </form>
        <a asp-page="/Tours/createTour" class="btn btn-primary">
            + Add Tour
        </a>
    </div>

    @if (Model.Tours != null && Model.Tours.Any())
    {
        <div class="row g-4">

            @foreach (var tour in Model.Tours)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title fw-bold">
                                @tour.Name
                            </h5>

                            <p class="card-text text-muted">
                                @tour.Description
                            </p>

                            <div class="mb-2">
                                <strong>Seats:</strong>
                                @tour.Seats
                            </div>

                          

                            <div class="d-flex gap-2 mt-auto">

                                <a asp-page="/Tours/Details"
                                   asp-route-id="@tour.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Details
                                </a>

                                <a asp-page="/Tours/EditTour"
                                   asp-route-id="@tour.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    Edit
                                </a>

                                <a asp-page="/Tours/DeleteTour"
                                   asp-route-id="@tour.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    Delete
                                </a>

                            </div>

                        </div>

                    </div>
                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <h5>No tours found</h5>
            <p class="mb-3">
                You haven't added any tours yet.
            </p>

            <a asp-page="/Tours/createTour" class="btn btn-primary">
                + Add Your First Tour
            </a>
        </div>
    }

</div>