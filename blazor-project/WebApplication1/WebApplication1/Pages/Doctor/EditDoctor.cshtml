@page
@model WebApplication1.Pages.Doctor.EditDoctor

@{
    ViewData["Title"] = "Edit Doctor";
}

<div class="appointment-wrapper">

    <div class="appointment-card">

        <div class="appointment-header">

            <div class="appointment-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

            <div>
                <h2>Edit Doctor</h2>
                <p>Update doctor information</p>
            </div>

        </div>

        <form method="post">

            <!-- Important: keep the ID -->
            <input type="hidden" asp-for="Doctor.Id" />

            <div class="row g-4">

                <!-- Doctor Name -->
                <div class="col-md-6">

                    <label asp-for="Doctor.Name" class="form-label">
                        Doctor Name
                    </label>

                    <div class="input-group-modern">
                        <i class="bi bi-person"></i>

                        <input asp-for="Doctor.Name"
                               type="text"
                               class="form-control"
                               placeholder="Enter doctor name"
                               required />
                    </div>

                    <span asp-validation-for="Doctor.Name"
                          class="text-danger">
                    </span>

                </div>

                <!-- Email -->
                <div class="col-md-6">

                    <label asp-for="Doctor.Email" class="form-label">
                        Email
                    </label>

                    <div class="input-group-modern">
                        <i class="bi bi-envelope"></i>

                        <input asp-for="Doctor.Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter email address"
                               required />
                    </div>

                    <span asp-validation-for="Doctor.Email"
                          class="text-danger">
                    </span>

                </div>

                <!-- Department -->
                <div class="col-md-6">

                    <label asp-for="Doctor.Department" class="form-label">
                        Department
                    </label>

                    <div class="input-group-modern">
                        <i class="bi bi-hospital"></i>

                        <input asp-for="Doctor.Department"
                               type="text"
                               class="form-control"
                               placeholder="Enter department"
                               required />
                    </div>

                    <span asp-validation-for="Doctor.Department"
                          class="text-danger">
                    </span>

                </div>

                <!-- Phone -->
                <div class="col-md-6">

                    <label asp-for="Doctor.Phone" class="form-label">
                        Phone Number
                    </label>

                    <div class="input-group-modern">
                        <i class="bi bi-telephone"></i>

                        <input asp-for="Doctor.Phone"
                               type="tel"
                               class="form-control"
                               placeholder="Enter phone number"
                               required />
                    </div>

                    <span asp-validation-for="Doctor.Phone"
                          class="text-danger">
                    </span>

                </div>

                <!-- Submit -->
                <div class="col-12">

                    <button type="submit" class="btn-book">
                        <i class="bi bi-check-circle"></i>
                        Update Doctor
                        <i class="bi bi-arrow-right"></i>
                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}