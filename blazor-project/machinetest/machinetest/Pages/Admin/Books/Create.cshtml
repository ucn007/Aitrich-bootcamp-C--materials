
@page
@model machinetest.Pages.Admin.Books.Create

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Add Book - Library Management</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>

<body class="bg-light">

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <!-- Card -->
            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <!-- Header -->
                    <div class="mb-4">

                        <h3 class="fw-bold mb-1">
                            📚 Add New Book
                        </h3>

                        <p class="text-muted mb-0">
                            Add a new book to the library.
                        </p>

                    </div>


                    <!-- Validation -->
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>


                    <!-- Form -->
                    <form method="post">

                        <!-- Title -->
                        <div class="mb-3">

                            <label asp-for="Book.title"
                                   class="form-label fw-semibold">
                                Book Title
                            </label>

                            <input asp-for="Book.title"
                                   class="form-control"
                                   placeholder="Enter book title" />

                            <span asp-validation-for="Book.title"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Author -->
                        <div class="mb-3">

                            <label asp-for="Book.author"
                                   class="form-label fw-semibold">
                                Author
                            </label>

                            <input asp-for="Book.author"
                                   class="form-control"
                                   placeholder="Enter author name" />

                            <span asp-validation-for="Book.author"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Quantity -->
                        <div class="mb-4">

                            <label asp-for="Book.quantity"
                                   class="form-label fw-semibold">
                                Quantity
                            </label>

                            <input asp-for="Book.quantity"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Enter quantity" />

                            <span asp-validation-for="Book.quantity"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-fill">
                                Add Book
                            </button>

                            <a asp-page="/Admin/Index"
                               class="btn btn-outline-secondary flex-fill">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

</body>
</html>



 