@page
@model TourConsultant_login.Pages.Userpage.LoginModel
@{
    ViewData["Title"] = "Login";
}



<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-lg">
                <div class="card-header bg-success text-white text-center">
                    <h3>Login</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="LoginDto.UserName" class="form-label"></label>
                            <input asp-for="LoginDto.UserName" class="form-control" placeholder="Username" />
                            <span asp-validation-for="LoginDto.UserName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="LoginDto.Password" class="form-label"></label>
                            <input asp-for="LoginDto.Password" class="form-control" type="password" placeholder="Password" />
                            <span asp-validation-for="LoginDto.Password" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-block">Login</button>
                        </div>
                    </form>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-3">
                            @TempData["ErrorMessage"]
                        </div>
                    }
                </div>
                <div class="card-footer text-center">
                    Don't have an account? <a asp-page="/Account/Register">Register</a>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-2">
        @TempData["ErrorMessage"]
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
