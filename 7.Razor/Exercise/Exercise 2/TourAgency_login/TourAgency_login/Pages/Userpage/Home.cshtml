@page
@model TourConsultant_login.Pages.Userpage.HomeModel
@{
    ViewData["Title"] = "Home";
    var userName = HttpContext.Session.GetString("UserName");
}

<!-- Top Navbar -->

    <div class="ms-auto">
        <a class="btn btn-light btn-sm me-2" asp-page="/Tourpage/CreateTour">Create Tour</a>
      
        <a class="btn btn-light btn-sm" asp-page="/Tourpage/TourIndex">My Tours</a>
    </div>


<div class="container py-5 ">

    <!-- Welcome Banner -->
    <div class="banner text-white p-5 rounded-4 shadow-lg mb-5 text-center">
        @if (!string.IsNullOrEmpty(userName))
        {
            <h2>Welcome, @userName 👋</h2>
        }
        else
        {
            <h2>Welcome to TourConsultant 🌍</h2>
        }
        <p class="lead">Discover breathtaking destinations and make your journey unforgettable.</p>
    </div>

    <!-- Destination Section -->
    <h3 class="mb-4">Popular Destinations</h3>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="destination-card">
                <img src="~/Images/img1.jpg" />
                <div class="card-body">
                    <h5>Paris</h5>
                    <p>Experience the beauty of Paris.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="destination-card">
                <img src="~/Images/img2.jpg" />
                <div class="card-body">
                    <h5>Dubai</h5>
                    <p>Luxury and adventure in Dubai.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="destination-card">
                <img src="~/Images/img3.jpg" />
                <div class="card-body">
                    <h5>Bali</h5>
                    <p>Relax in tropical paradise Bali.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="destination-card">
                <img src="~/Images/img4.jpg" />
                <div class="card-body">
                    <h5>London</h5>
                    <p>Explore historic London city.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="destination-card">
                <img src="~/Images/img5.jpg" />
                <div class="card-body">
                    <h5>Singapore</h5>
                    <p>Modern beauty of Singapore.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="destination-card">
                <img src="~/Images/img6.jpg" />
                <div class="card-body">
                    <h5>Maldives</h5>
                    <p>Crystal clear beaches in Maldives.</p>
                </div>
            </div>
        </div>

    </div>

</div>