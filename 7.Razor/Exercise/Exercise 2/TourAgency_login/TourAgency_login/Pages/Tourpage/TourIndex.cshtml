  
@page
@model TourConsultant_login.Pages.Tourpage.IndexModel
<h2 class="mb-4">Tour List</h2>

<a asp-page="/TourPage/CreateTour" class="btn btn-success mb-3">Create New Tour</a>

<table class="table table-bordered table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Tour Name</th>
            <th>Description</th>
            <th>Destination</th>
            <th>Price</th>
            <th>Nights</th>
            <th>Departure</th>
            <th>Arrival</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var tour in Model.Tours)
        {
            <tr>
                <td>@tour.TourName</td>
                <td>@tour.TourDescription</td>
                <td>@tour.Destination?.DestinationName</td>
                <td>@tour.Price</td>
                <td>@tour.NoOfNights</td>
                <td>@tour.DepartureDate?.ToString("dd-MM-yyyy")</td>
                <td>@tour.ArrivalDate?.ToString("dd-MM-yyyy")</td>
                <td>
                    <a asp-page="EditTour"
                       asp-route-id="@tour.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <form method="post"
                          asp-page-handler="Delete"
                          asp-route-id="@tour.Id"
                          style="display:inline;">
                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
