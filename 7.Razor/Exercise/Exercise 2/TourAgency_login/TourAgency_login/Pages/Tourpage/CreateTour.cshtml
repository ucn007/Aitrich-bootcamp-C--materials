@page
@model TourConsultant_login.Pages.Tourpage.CreateModel

<h2>Create Tour</h2>

<form method="post">

    <div class="mb-3">
        <label asp-for="Tour.TourName"></label>
        <input asp-for="Tour.TourName" class="form-control" />
        <span asp-validation-for="Tour.TourName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tour.TourDescription"></label>
        <textarea asp-for="Tour.TourDescription" class="form-control"></textarea>
        <span asp-validation-for="Tour.TourDescription" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tour.NoOfNights"></label>
        <input asp-for="Tour.NoOfNights" class="form-control" />
        <span asp-validation-for="Tour.NoOfNights" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tour.Price"></label>
        <input asp-for="Tour.Price" class="form-control" />
        <span asp-validation-for="Tour.Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tour.DepartureDate"></label>
        <input asp-for="Tour.DepartureDate" type="date" class="form-control" />
        <span asp-validation-for="Tour.DepartureDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tour.ArrivalDate"></label>
        <input asp-for="Tour.ArrivalDate" type="date" class="form-control" />
        <span asp-validation-for="Tour.ArrivalDate" class="text-danger"></span>
    </div>

    <select asp-for="Tour.DestinationId"
            asp-items="Model.DestinationList"
            class="form-control">
        <option value="">-- Select Destination --</option>
    </select>

    <button type="submit" class="btn btn-primary">Create</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}