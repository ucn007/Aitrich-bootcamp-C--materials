@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class<div class="container-fluid p-0">
    <div class="position-relative text-white text-center">
        <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e"
             class="img-fluid w-100"
             style="height:500px; object-fit:cover;" />

        <div class="position-absolute top-50 start-50 translate-middle">
            <h1 class="fw-bold display-4">Explore The World With Us</h1>
            <p class="lead">Professional Tour Consultation & Travel Planning</p>
            <a asp-page="/Register" class="btn btn-warning btn-lg mt-3">
                Book Your Tour
            </a>
        </div>
    </div>
</div>

<!-- ABOUT SECTION -->
<div class="container mt-5">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold">About Our Tour Services</h2>
            <p class="text-muted">
                We provide expert travel consultation, customized tour packages,
                visa assistance, and booking services to make your journey smooth
                and memorable.
            </p>
            <a asp-page="/Consultants" class="btn btn-success">
                Meet Our Consultants
            </a>
        </div>
        <div class="col-md-6">
            <img src="https://images.unsplash.com/photo-1491553895911-0055eca6402d"
                 class="img-fluid rounded shadow" />
        </div>
    </div>
</div>

<!-- POPULAR DESTINATIONS -->
<div class="container mt-5 mb-5">
    <h2 class="text-center fw-bold mb-4">Popular Destinations</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <img src="https://images.unsplash.com/photo-1502602898657-3e91760cbb34"
                     class="card-img-top" style="height:250px; object-fit:cover;" />
                <div class="card-body text-center">
                    <h5 class="card-title">Paris</h5>
                    <p class="card-text">Experience the beauty of France.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <img src="https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1"
                     class="card-img-top" style="height:250px; object-fit:cover;" />
                <div class="card-body text-center">
                    <h5 class="card-title">Maldives</h5>
                    <p class="card-text">Relax in tropical paradise beaches.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee"
                     class="card-img-top" style="height:250px; object-fit:cover;" />
                <div class="card-body text-center">
                    <h5 class="card-title">Dubai</h5>
                    <p class="card-text">Discover luxury and adventure.</p>
                </div>
            </div>
        </div>

    </div>
</div>