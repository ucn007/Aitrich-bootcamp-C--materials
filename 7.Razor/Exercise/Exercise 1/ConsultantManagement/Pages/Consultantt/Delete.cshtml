@page
@model ConsultantManagement.Pages.Consultantt.DeleteModel
@{
}
<h2>Delete Job</h2>

<h3>Are you sure you want to delete this job?</h3>

<div>
    <h4>Consultant Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.ConsultantInfo.Name</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.ConsultantInfo.Email</dd>

        <dt class="col-sm-2">Phone Number</dt>
        <dd class="col-sm-10">@Model.ConsultantInfo.Phone</dd>

        <dt class="col-sm-2">Username</dt>
        <dd class="col-sm-10">@Model.ConsultantInfo.Username</dd>

        <dt class="col-sm-2">Assigned Tours</dt>
        <dd class="col-sm-10">@Model.ConsultantInfo.AssignedTours</dd>
        <dt class="col-sm-2">Bookings</dt>
        <dd class="col-sm-10">@Model.ConsultantInfo.Bookings</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.ConsultantInfo.Status</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="ConsultantInfo.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
