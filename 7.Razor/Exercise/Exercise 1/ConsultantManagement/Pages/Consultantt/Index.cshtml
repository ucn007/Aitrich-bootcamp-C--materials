@page
@using StatusEnum = ConsultantManagement.Enums.Status

@model ConsultantManagement.Pages.Consultantt.IndexModel

@{
}
<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold">Consultant Management</h4>
            <small class="text-muted">Add and manage your consultants</small>
        </div>
        <a asp-page="/Consultantt/Create" class="btn btn-primary">
            <i class="bi bi-plus"></i> Add Consultant
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-primary text-white rounded p-2 me-3">
                        <i class="bi bi-people"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">Total Consultants</h6>
                        <h4 class="mb-0">@Model.TotalConsultants</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-success text-white rounded p-2 me-3">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">Active</h6>
                        <h4 class="mb-0">
                            @Model.ConsultantInfo.Count(c => c.Status == StatusEnum.Active)
                        </h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-warning text-white rounded p-2 me-3">
                        <i class="bi bi-person-dash"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">Pending</h6>
                        <h4 class="mb-0">
                            @Model.ConsultantInfo.Count(c => c.Status == StatusEnum.Pending)
                        </h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-info text-white rounded p-2 me-3">
                        <i class="bi bi-journal-check"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">Total Bookings</h6>
                        <h4 class="mb-0">0</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Username</th>
                        <th>Assigned Tours</th>
                        <th>Bookings</th>
                        <th>Status</th>
                        <th>Joined Date</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.ConsultantInfo)
                    {
                        <tr>
                            <td>
                                <strong>@c.Name</strong><br />
                                <small class="text-muted">@c.Gender</small>
                            </td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>@c.Username</td>
                            <td>@c.AssignedTours</td>
                            <td>@c.Bookings</td>

                            <td>
                                @if (c.Status == StatusEnum.Active)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else if (c.Status == StatusEnum.Pending)
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </td>
                            <td>@c.JoinedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                <a asp-page="/Consultantt/View" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="/Consultantt/Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="/Consultantt/Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>