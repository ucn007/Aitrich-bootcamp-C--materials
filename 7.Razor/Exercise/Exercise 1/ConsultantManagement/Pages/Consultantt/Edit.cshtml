@page
@model ConsultantManagement.Pages.Consultantt.EditModel
@{
}
<h2>Edit Consultants</h2>

<form method="post">
    <input type="hidden" asp-for="ConsultantInfo.Id" />
    <div class="form-group">
        <label asp-for="ConsultantInfo.Name" class="control-label"></label>
        <input asp-for="ConsultantInfo.Name" class="form-control" />
        <span asp-validation-for="ConsultantInfo.Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConsultantInfo.Email" class="control-label"></label>
        <input asp-for="ConsultantInfo.Email" class="form-control" />
        <span asp-validation-for="ConsultantInfo.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConsultantInfo.Phone" class="control-label"></label>
        <input asp-for="ConsultantInfo.Phone" class="form-control" />
        <span asp-validation-for="ConsultantInfo.Phone" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConsultantInfo.Gender" class="control-label"></label>
        <select asp-for="ConsultantInfo.Gender" class="form-control">
            <option value="Full-time">Male</option>
            <option value="Part-time">Female</option>
            <option value="Contract">Other</option>
        </select>
        <span asp-validation-for="ConsultantInfo.Gender" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConsultantInfo.Username" class="control-label"></label>
        <input asp-for="ConsultantInfo.Username" class="form-control" />
        <span asp-validation-for="ConsultantInfo.Username" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConsultantInfo.Password" class="control-label"></label>
        <input asp-for="ConsultantInfo.Password" class="form-control" />
        <span asp-validation-for="ConsultantInfo.Password" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConsultantInfo.AssignedTours" class="control-label"></label>
        <input asp-for="ConsultantInfo.AssignedTours" class="form-control" />
        <span asp-validation-for="ConsultantInfo.AssignedTours" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConsultantInfo.Bookings" class="control-label"></label>
        <input asp-for="ConsultantInfo.Bookings" class="form-control" />
        <span asp-validation-for="ConsultantInfo.Bookings" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConsultantInfo.Status" class="control-label"></label>
        <input asp-for="ConsultantInfo.Status" class="form-control" />
        <span asp-validation-for="ConsultantInfo.Status" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success mt-3">Save Changes</button>
    <a asp-page="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
