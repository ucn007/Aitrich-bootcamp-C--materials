@page
@model TourConsultant_login.Pages.Userpage.RegisterModel
@{
    ViewData["Title"] = "Register";
}



<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h3>Create Your Account</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="row mb-3">
                            <div class="col">
                                <label asp-for="RegisterDto.FirstName" class="form-label"></label>
                                <input asp-for="RegisterDto.FirstName" class="form-control" placeholder="First Name" />
                                <span asp-validation-for="RegisterDto.FirstName" class="text-danger"></span>
                            </div>
                            <div class="col">
                                <label asp-for="RegisterDto.LastName" class="form-label"></label>
                                <input asp-for="RegisterDto.LastName" class="form-control" placeholder="Last Name" />
                                <span asp-validation-for="RegisterDto.LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterDto.Gender" class="form-label"></label>
                            <select asp-for="RegisterDto.Gender" class="form-select">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                            <span asp-validation-for="RegisterDto.Gender" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterDto.Dob" class="form-label"></label>
                            <input asp-for="RegisterDto.Dob" class="form-control" type="date" />
                            <span asp-validation-for="RegisterDto.Dob" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterDto.UserName" class="form-label"></label>
                            <input asp-for="RegisterDto.UserName" class="form-control" placeholder="Username" />
                            <span asp-validation-for="RegisterDto.UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterDto.Password" class="form-label"></label>
                            <input asp-for="RegisterDto.Password" class="form-control" type="password" placeholder="Password" />
                            <span asp-validation-for="RegisterDto.Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterDto.EmailId" class="form-label"></label>
                            <input asp-for="RegisterDto.EmailId" class="form-control" placeholder="Email" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="RegisterDto.TelephoneNo" class="form-label"></label>
                            <input asp-for="RegisterDto.TelephoneNo" class="form-control" placeholder="Phone Number" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-block">Register</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center">
                    Already have an account? <a asp-page="/Account/Login">Login</a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}