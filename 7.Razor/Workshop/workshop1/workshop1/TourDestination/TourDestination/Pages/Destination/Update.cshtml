@page
@model TourDestination.Pages.Destination.UpdateModel
@{
    ViewData["Title"] = "Update Destination";
}

<h2>Update Destination</h2>

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="DestinationDto.Id" />

    <div class="form-group">
        <label asp-for="DestinationDto.Name"></label>
        <input asp-for="DestinationDto.Name" class="form-control" />
        <span asp-validation-for="DestinationDto.Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DestinationDto.City"></label>
        <input asp-for="DestinationDto.City" class="form-control" />
        <span asp-validation-for="DestinationDto.City" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Current Image:</label><br />
        @if (!string.IsNullOrEmpty(Model.DestinationDto.ImagePath))
        {
            <img src="@Url.Content(Model.DestinationDto.ImagePath)" width="150" />
        }
    </div>

    <input type="hidden" asp-for="DestinationDto.ImagePath" />

    <div class="form-group">
        <label asp-for="DestinationDto.ImageFile">
            Upload New Image (optional):
        </label>
        <input asp-for="DestinationDto.ImageFile" type="file" class="form-control" />
    </div>

   

    <button type="submit" class="btn btn-primary mt-3">Update</button>
    <a asp-page="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>
