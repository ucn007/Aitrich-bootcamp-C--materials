

@page
@model TourDestination.Pages.Destination.CreateModel
@{
    ViewData["Title"] = "Register New Destination";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h3>Register New Destination</h3>
                </div>
                <div class="card-body">
                   


                    <form method="post" enctype="multipart/form-data" class="border p-4 rounded shadow-sm bg-light">
                        <div class="form-group mb-3">
                            <label asp-for="DestinationDto.Name" class="form-label"></label>
                            <input asp-for="DestinationDto.Name" class="form-control" />
                            <span asp-validation-for="DestinationDto.Name" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="DestinationDto.City" class="form-label"></label>
                            <input asp-for="DestinationDto.City" class="form-control" />
                            <span asp-validation-for="DestinationDto.City" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="DestinationDto.ImageFile" class="form-label"></label>
                            <input asp-for="DestinationDto.ImageFile" type="file" class="form-control" />
                            <span asp-validation-for="DestinationDto.ImageFile" class="text-danger"></span>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary px-4">Save</button>
                            <a asp-page="Index" class="btn btn-secondary px-4">Cancel</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
