@page
@model TourDestination.Pages.Destination.DeleteModel
@{
}
<h2>Delete Destination</h2>

<div class="card" style="width: 24rem; margin-top: 20px;">
    <img src="@Model.DestinationDto.ImagePath" class="card-img-top" alt="Destination image" />
    <div class="card-body">
        <h5 class="card-title">@Model.DestinationDto.Name</h5>
        <p class="card-text">City: @Model.DestinationDto.City</p>
    </div>
</div>

<form method="post" style="margin-top: 20px;">
    <input type="hidden" asp-for="DestinationDto.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
