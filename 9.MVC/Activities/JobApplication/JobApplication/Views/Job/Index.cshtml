@model IEnumerable<JobApplication.DTOs.Job.JobResponseDto>

@{
Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Jobs</title>


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
        }

        .page-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .page-title {
            margin: 0;
            font-size: 28px;
            font-weight: 600;
        }

        .job-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 22px;
            margin-bottom: 15px;
            transition: box-shadow 0.2s ease;
        }

        .job-card:hover {
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .job-title {
            font-size: 19px;
            font-weight: 600;
            color: #212529;
            margin-bottom: 8px;
        }

        .job-description {
            color: #6c757d;
            margin-bottom: 15px;
        }

        .job-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            color: #6c757d;
            font-size: 14px;
        }

        .empty-state {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 80px 20px;
            text-align: center;
        }

        .empty-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 20px;
            border-radius: 50%;
            background: #f1f3f5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

        .empty-state h3 {
            font-size: 22px;
            margin-bottom: 8px;
        }

        .empty-state p {
            color: #6c757d;
            margin-bottom: 25px;
        }
    </style>


</head>

<body>

<div class="page-container">


    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Jobs</h1>
            <p class="text-muted mb-0">
                Manage your job postings
            </p>
        </div>

        @if (User.IsInRole("Company"))
        {
        <a href="@Url.Action("Create", "Job")"
           class="btn btn-primary">
            + Create Job
        </a>
        }
    </div>


    @if (Model != null && Model.Any())
    {
    <!-- Job List -->
    <div class="job-list">

        @foreach (var job in Model)
        {
        <div class="job-card">

            <div class="d-flex justify-content-between align-items-start">

                <div class="w-100">

                    <!-- Job Title -->
                    <div class="job-title">
                        @job.JobTitle
                    </div>

                    <!-- Description -->
                    <div class="job-description">
                        @job.Description
                    </div>

                    <!-- Job Information -->
                    <div class="job-meta">

                           

                        <span>
                                💼 @job.JobType
                            </span>

                        <span>
                                🎯 @job.Experience years experience
                            </span>

                        <span>
                                📅 @job.CreatedAt.ToString("dd MMM yyyy")
                            </span>

                    </div>

                </div>

            </div>


            <!-- Actions -->
            <div class="mt-3">

                <a href="@Url.Action("Details", "Job", new { id = job.JobId })"
                   class="btn btn-sm btn-outline-primary">
                    View
                </a>

                @if (User.IsInRole("Company") && job.CompId.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                {
                <a href="@Url.Action("Edit", "Job", new { id = job.JobId })"
                   class="btn btn-sm btn-outline-secondary">
                    Edit
                </a>
                }

            </div>

        </div>
        }

    </div>
    }
    else
    {
    <!-- Empty State -->
    <div class="empty-state">

        <div class="empty-icon">
            💼
        </div>

        <h3>No jobs found</h3>

        <p>
            You haven't created any jobs yet.
            Create your first job posting to get started.
        </p>

        @if (User.IsInRole("Company"))
        {
        <a href="@Url.Action("Create", "Job")"
           class="btn btn-primary">
            + Create Your First Job
        </a>
        }

    </div>
    }
    

</div>

</body>
</html>
