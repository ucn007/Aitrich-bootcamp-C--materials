@model JobApplication.DTOs.Job.CreateJobDto

@{
Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

 
<title>Create Job Posting</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet" />

<style>
    body {
        background-color: #f8f9fa;
    }

    .page-container {
        max-width: 850px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .page-title {
        font-size: 28px;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .page-description {
        color: #6c757d;
        margin-bottom: 30px;
    }

    .form-label {
        font-weight: 500;
        margin-bottom: 7px;
    }

    .required {
        color: #dc3545;
    }

    .form-control,
    .form-select {
        padding: 10px 12px;
    }

    textarea.form-control {
        min-height: 180px;
        resize: vertical;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e9ecef;
    }
</style>
 

</head>

<body>

<div class="page-container">

 
<div class="mb-4">
    <h1 class="page-title">Create Job Posting</h1>
    <p class="page-description">
        Create a new job posting and provide the details candidates need.
    </p>
</div>

<div class="form-card">

    <form asp-action="Create" asp-controller="Job" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <!-- Job Title -->
        <div class="mb-4">
            <label asp-for="JobTitle" class="form-label">
                Job Title <span class="required">*</span>
            </label>

            <input asp-for="JobTitle"
                   class="form-control"
                   placeholder="e.g. Senior Software Engineer" />

            <span asp-validation-for="JobTitle"
                  class="text-danger">
            </span>
        </div>

        <!-- Description -->
        <div class="mb-4">
            <label asp-for="Description" class="form-label">
                Job Description <span class="required">*</span>
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      placeholder="Describe the role, responsibilities, requirements, and qualifications..."></textarea>

            <span asp-validation-for="Description"
                  class="text-danger">
            </span>
        </div>

        <!-- Experience + Job Type -->
        <div class="row">

            <div class="col-md-6 mb-4">
                <label asp-for="Experience" class="form-label">
                    Experience <span class="required">*</span>
                </label>

                <div class="input-group">
                    <input asp-for="Experience"
                           type="number"
                           step="0.1"
                           min="0"
                           class="form-control"
                           placeholder="e.g. 2" />

                    <span class="input-group-text">
                        Years
                    </span>
                </div>

                <span asp-validation-for="Experience"
                      class="text-danger">
                </span>
            </div>

            <div class="col-md-6 mb-4">
                <label asp-for="JobType" class="form-label">
                    Job Type <span class="required">*</span>
                </label>

                <select asp-for="JobType"
                        class="form-select">

                    <option value="">Select job type</option>
                    <option value="Full Time">Full Time</option>
                    <option value="Part Time">Part Time</option>
                    <option value="Contract">Contract</option>
                    <option value="Internship">Internship</option>
                    <option value="Temporary">Temporary</option>

                </select>

                <span asp-validation-for="JobType"
                      class="text-danger">
                </span>
            </div>

        </div>

        <!-- Form Actions -->
        <div class="form-actions">

            <a asp-action="Index"
               asp-controller="Jobs"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary px-4">
                Create Job
            </button>

        </div>

    </form>

</div>


</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<partial name="_ValidationScriptsPartial" />

</body>
</html>
