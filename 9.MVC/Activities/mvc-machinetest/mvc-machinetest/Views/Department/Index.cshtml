 
@model List<mvc_machinetest.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Departments</h2>
        <p class="text-muted mb-0">Manage departments and their employees.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Department</a>
</div>

@if (Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Employees</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var department in Model)
                {
                    <tr>
                        <td class="fw-semibold">@department.Name</td>
                        <td>@department.Employees.Count</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@department.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@department.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="py-5 text-center">
        <h4>No departments yet</h4>
        <p class="text-muted">Create a department to assign it to employees.</p>
        <a asp-action="Create" class="btn btn-primary">Add Department</a>
    </div>
}