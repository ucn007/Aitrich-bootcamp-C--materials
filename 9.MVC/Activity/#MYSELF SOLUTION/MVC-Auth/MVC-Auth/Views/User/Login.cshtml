@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model MVC_Auth.Dto.LoginDto // Update this line if your Login DTO namespace is different

@{
    ViewData["Title"] = "Log In";
}
<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2>Welcome Back</h2>
            <p>Please enter your credentials to log in.</p>
        </div>

        <form method="post" asp-action="Login" class="login-form">
            @* Optional: Anti-forgery token for security *@
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="Email">Email Address</label>
                <div class="input-wrapper">
                    <input type="email"
                           id="Email"
                           name="Email"
                           placeholder="name@example.com"
                           required
                           autocomplete="email" />
                </div>
            </div>

            <div class="form-group">
                <label for="Password">Password</label>
                <div class="input-wrapper">
                    <input type="password"
                           id="Password"
                           name="Password"
                           placeholder="••••••••"
                           required
                           autocomplete="current-password" />
                </div>
            </div>

            <button type="submit" class="btn-submit">
                <span>Login</span>
            </button>
        </form>

        <div class="login-footer">
            <p>Don't have an account? <a href="@Url.Action("Register", "User")">Register</a></p>
        </div>
    </div>
</div>

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-card {
        background: #ffffff;
        width: 100%;
        max-width: 420px;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        border: 1px solid #eef2f6;
    }

    .login-header {
        text-align: center;
        margin-bottom: 28px;
    }

        .login-header h2 {
            margin: 0 0 8px 0;
            font-size: 26px;
            font-weight: 700;
            color: #1e293b;
        }

        .login-header p {
            margin: 0;
            font-size: 14px;
            color: #64748b;
        }

    .login-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: #334155;
        }

    .input-wrapper input {
        width: 100%;
        padding: 12px 14px;
        font-size: 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background-color: #f8fafc;
        transition: all 0.2s ease-in-out;
        box-sizing: border-box;
    }

        .input-wrapper input:focus {
            outline: none;
            border-color: #4f46e5;
            background-color: #ffffff;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

    .btn-submit {
        margin-top: 8px;
        padding: 12px;
        background-color: #4f46e5;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.1s ease;
    }

        .btn-submit:hover {
            background-color: #4338ca;
        }

        .btn-submit:active {
            transform: scale(0.99);
        }

    .login-footer {
        margin-top: 24px;
        text-align: center;
        font-size: 14px;
        color: #64748b;
    }

        .login-footer a {
            color: #4f46e5;
            text-decoration: none;
            font-weight: 600;
        }

            .login-footer a:hover {
                text-decoration: underline;
            }
</style>